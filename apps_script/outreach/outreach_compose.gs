  return SENDER_LINKS;
}

function outreachBusinessCardHtml_() {
  return '<table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin-top:8px;font-family:\'Trebuchet MS\',Arial,sans-serif;font-size:12px;color:#555">' +
