    '<a href="https://www.kenyon.edu/"><img src="cid:kenyonlogo" alt="Kenyon College" width="148" style="display:block;width:148px;height:auto;border:0"></a>' +
    '</td><td style="vertical-align:middle;padding:0 0 0 10px;line-height:1.35;white-space:nowrap">' +
    '<div><span style="color:#4B2E84">Email:</span> <a href="mailto:hoanng15.work@gmail.com" style="color:#1155cc;text-decoration:underline">hoanng15.work@gmail.com</a></div>' +
    '<div><span style="color:#4B2E84">LinkedIn:</span> <a href="https://www.linkedin.com/in/hoanng15/" style="color:#1155cc;text-decoration:underline">https://www.linkedin.com/in/hoanng15/</a></div>' +
