/**
 * Outreach -- building one email out of one template.
 *
 * The wording no longer lives here. It is in ColdEmail's two Markdown files and
 * reaches this project through outreach_templates.gs, which is generated by
 * scripts/build_templates.py and never hand-edited. This file is the machinery:
 * pick one of the ten, fill three placeholders, render both halves.
 *
 * That replaced a generated set of thirty cold variations -- ten factual base
 * templates crossed with three copy forms -- selected on the recipient's Focus
 * and the employer's Bucket, with a per-recruiter hook and a per-company angle
 * dropped into a "Why I'm reaching out" section. All of it is gone, along with
 * the resume-bullet table it drew its proof points from and the short-role rule
 * that rewrote a job-board title into three words for the subject line.
 *
 * What replaces it says the same four facts in every message and varies only in
 * phrasing. The trade is deliberate: nothing is personalised to the reader
 * beyond their first name and their employer, and nothing can be, because the
 * templates have nowhere to put it.
 *
 * Selection is therefore the whole of the remaining logic, and it exists for one
 * reason -- so that several people at one employer do not read one message.
 */
var SENDER_NAME  = 'Henry Nguyen';
var SENDER_LINKS = 'hoanng15.work@gmail.com · linkedin.com/in/hoanng15 · github.com/henryng15';
/**
 * Which of the ten a new row gets: the least used so far, ties to the lowest
 * number.
 *
 * Ten fixed templates replaced a generated set of thirty (ten factual bases
 * times three copy forms) that was chosen on the contact's Focus and the
 * company's Bucket. Nothing selects on the recipient any more, because nothing
 * in the new wording varies with them -- every template says the same four
 * facts and differs only in phrasing. Balancing is therefore the whole of the
 * selection rule, and it exists for one reason: so that several people at one
 * employer do not receive the identical message.
 */
function outreachColdTemplateLoad_(queueRows) {
  var load = {};
  for (var i = 1; i <= COLD_TEMPLATES.length; i++) load[i] = 0;
  (queueRows || []).forEach(function (row) {
    if (row.status === STATUS_CANCELLED) return;
    var n = Number(row.template);
    if (load[n] !== undefined) load[n]++;
  });
  return load;
}

function outreachLeastUsedTemplate_(load, count) {
  var best = 1;
  for (var n = 2; n <= count; n++) {
    if ((load[n] || 0) < (load[best] || 0)) best = n;
  }
  return best;
}

function outreachColdTemplateFor_(load) {
  return outreachLeastUsedTemplate_(load || {}, COLD_TEMPLATES.length);
}

/**
 * Fill the only three placeholders the templates have.
 *
 * A placeholder nothing fills reaches a recruiter as square brackets, so each
 * one falls back to something that reads as a sentence rather than to an empty
 * string: "your team" is wrong but not visibly broken, and the generator in
 * scripts/build_templates.py refuses any placeholder not handled here.
 */
function outreachFillTemplate_(text, values) {
  return String(text == null ? '' : text)
    .replace(/\[Name\]/g, values.name || 'there')
    .replace(/\[Company\]/g, values.company || 'your team')
    .replace(/\[Role Name\]/g, values.role || DEFAULT_SHORT_ROLE);
}

/**
 * One template plus one recipient, as both halves of a message.
 *
 * Cold and referral share this because their templates share a shape: a
 * greeting, one opening paragraph, three headed sections -- the first a bullet
 * list, the other two a short paragraph each -- a closing line and a sign-off.
 * The indented `>` blocks in the Markdown become an indented block here, which
 * is what makes the four facts skimmable rather than a wall.
 */
function outreachRenderTemplate_(template, values) {
  var fill = function (text) { return outreachFillTemplate_(text, values); };
  var greeting = 'Hi ' + (values.name || 'there') + ',';
  var quote = 'margin:0 0 0 12px;padding-left:12px;border-left:2px solid #ddd';

  var html = ['<p>' + outreachEscape_(greeting) + '</p>',
              '<p>' + outreachBoldHtml_(fill(template.opening)) + '</p>'];
  var plain = [greeting, '', outreachBoldPlain_(fill(template.opening))];

  template.sections.forEach(function (section) {
    html.push('<p><b>' + outreachEscape_(fill(section.heading)) + '</b></p>');
    plain.push('', fill(section.heading));
    if (section.bullets && section.bullets.length) {
      html.push('<ul style="' + quote + '">' + section.bullets.map(function (line) {
        return '<li>' + outreachBoldHtml_(fill(line)) + '</li>';
      }).join('') + '</ul>');
      section.bullets.forEach(function (line) {
        plain.push('  - ' + outreachBoldPlain_(fill(line)));
      });
    } else {
      html.push('<p style="' + quote + '">' + outreachBoldHtml_(fill(section.body)) + '</p>');
      plain.push(outreachBoldPlain_(fill(section.body)));
    }
  });

  // Every trailing paragraph, because the referral templates end with two: the
  // line saying the resume is attached, and then the thank-you.
  template.closing.forEach(function (line) {
    html.push('<p>' + outreachBoldHtml_(fill(line)) + '</p>');
    plain.push('', outreachBoldPlain_(fill(line)));
  });
  html.push('<p>Best,<br>' + outreachEscape_(template.signOff) + '<br>'
            + '<span style="color:#666">' + outreachEscape_(SENDER_LINKS) + '</span></p>');
  plain.push('', 'Best,', template.signOff, SENDER_LINKS);

  return { subject: fill(template.subject), html: html.join(''), plain: plain.join('\n') };
}

function outreachEscape_(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/** `**bold**` becomes <b>bold</b> once the surrounding text is already escaped. */
function outreachBoldHtml_(text) {
  return outreachEscape_(text).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
}

function outreachBoldPlain_(text) {
  return String(text).replace(/\*\*(.+?)\*\*/g, '$1');
}

function outreachFirstName_(name) {
  return String(name || '').trim().split(/\s+/)[0] || 'there';
}

// What [Role Name] falls back to when an application row has no title. The
// templates say "I have already applied for X", so an empty X would read as a
// missing word rather than as a generic one.
//
// The table of short role names that used to sit here, and outreachShortRole_
// which read it, are gone with the subject line that needed them: the ten
// subjects are fixed strings and the body names the posting title as written,
// because "I have already applied for X" is a claim the reader checks against
// their own system and a shortened title would not match it.
var DEFAULT_SHORT_ROLE = 'Software Engineer Intern';

/**
 * One cold email, from a template number and the row it belongs to.
 *
 * The hook, the angle, the focus and the bucket are all gone from the wording.
 * The ten templates say the same four facts about Henry in ten phrasings and
 * name only the company and the role, so a recruiter-specific hook has nothing
 * to attach to and a company angle has nowhere to sit. Those columns still
 * exist on the contacts tab and still decide other things, but they no longer
 * reach a reader through this function.
 *
 * That is a real loss and worth naming: the previous message opened with a line
 * about this particular recruiter. What replaces it is a fixed opening that says
 * how Henry found them. The trade was asked for deliberately.
 *
 * It also removes what used to decide whether a row could send at all. A row
 * with no Angle was drafted rather than sent, because an angle was a thing the
 * message needed; these templates need nothing from the contact but a first
 * name, so that distinction has gone with the copy that motivated it.
 */
function outreachCompose_(options) {
  var n = Number(options.template);
  if (!(n >= 1 && n <= COLD_TEMPLATES.length)) n = 1;
  var rendered = outreachRenderTemplate_(COLD_TEMPLATES[n - 1], {
    name: outreachFirstName_(options.recruiterName),
    company: options.company,
    role: options.role || DEFAULT_SHORT_ROLE
  });
  return {
    subject: rendered.subject,
    html: rendered.html,
    plain: rendered.plain,
    template: n
  };
}
