  {company: 'Toast', name: 'Maja Brajkovic', email: 'maja.brajkovic@toasttab.com',
   role: 'Senior Technical Recruiter', focus: '', verify: 'trykitt:accept_all'}
];

var TARGET_SWELIKE_SOURCE_20260917_ =
  'Treg people search + Treg email verifier — user approved 2026-09-15';

/**
 * Append an owner-approved, externally verified roster to Contacts (manual).
 *
 * The same narrow exception appendTargetPriorityHunterRecruiters_ takes, written
 * once so a second approved roster does not mean a second copy of the row
 * assembly. An address either contacts tab already knows wins and is never
 * rewritten: the seed export and the hand-curated tab both outrank a lookup.
 */
function appendApprovedManualRecruiters_(roster, defaultSource) {
  var contactsBook = SpreadsheetApp.openById(outreachProperty_(PROP_CONTACTS_ID, true));
  var known = {};
  outreachReadContacts_(contactsBook).forEach(function (contact) {
    known[contact.email] = true;
  });
  var sheet = contactsBook.getSheetByName(TAB_CONTACTS_MANUAL);
  if (!sheet) throw new Error('Contacts (manual) is missing.');
  var rows = [], added = [];
  (roster || []).forEach(function (person) {
    var email = String(person.email || '').toLowerCase();
    // Fail closed rather than write a blank address: a row with no email is one
    // the scheduler silently skips, which then reads as "nobody works there".
    if (!email) throw new Error('Approved roster row has no email: ' + person.name);
    if (known[email]) return;
    var row = new Array(C_WIDTH).fill('');
    row[C_COMPANY - 1] = person.company;
    row[C_NAME - 1] = person.name;
    row[C_EMAIL - 1] = email;
    row[C_ROLE - 1] = person.role;
    row[C_FOCUS - 1] = person.focus || '';
    row[C_VERIFY - 1] = person.verify || 'valid';
    row[C_FROM - 1] = person.source || defaultSource;
    rows.push(row);
    added.push({company: person.company, name: person.name, role: person.role});
    known[email] = true;
  });
  if (rows.length) sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, C_WIDTH).setValues(rows);
  return {added: added, existing: (roster || []).length - rows.length};
}

