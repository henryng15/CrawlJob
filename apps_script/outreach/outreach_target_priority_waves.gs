/**
 * Cancel either 2026-09-17 off-Target wave, pending entries only.
 *
 * Sent, bounced and failed entries are history and are left exactly as they are;
 * if the campaign holds any, this refuses rather than rewrite a record of what
 * the mailbox really did. It clears only that campaign's own property and then
 * refreshes the mirrors, and it touches no trigger: the shared recruiter tick
 * belongs to every direct campaign, not to this one.
 */
function cancelTargetRecruiterCampaign0917SweLike(acceptAllInstead) {
  var key = acceptAllInstead
    ? 'TARGET_RECRUITER_CAMPAIGN_20260917_SWELIKE_ACCEPTALL'
    : 'TARGET_RECRUITER_CAMPAIGN_20260917_SWELIKE';
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('Another outreach run holds the lock.');
  try {
    var props = PropertiesService.getScriptProperties();
    var text = props.getProperty(key);
    if (!text) return {exists: false, key: key};
    var state = JSON.parse(text);
    var settled = (state.entries || []).filter(function (entry) {
      return entry.status !== 'pending';
    });
    if (settled.length) {
      throw new Error('Refusing to cancel: ' + settled.length
        + ' entr' + (settled.length === 1 ? 'y has' : 'ies have')
        + ' already left pending; that history stays.');
    }
    var cancelled = (state.entries || []).length;
    props.deleteProperty(key);
    try { refreshTargetQueueTabs_(); }
    catch (mirrorError) { Logger.log('Target mirror refresh failed: ' + mirrorError); }
    return {cancelled: cancelled, key: key};
  } finally {
    lock.releaseLock();
  }
}

