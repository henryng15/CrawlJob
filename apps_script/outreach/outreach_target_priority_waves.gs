  var state = {status: 'scheduled', timezone: 'America/New_York', createdAt: new Date().toISOString(),
    lastSentAtMs: 0, spacingMinutes: 6, minGapMinutes: 5, entries: entries};
  props.setProperty(key, JSON.stringify(state));
  refreshTargetQueueTabs_();
  return {scheduled: entries.length, byCompany: summarizeTargetCampaignState_(state, 'Wells Fargo').byCompany,
    firstAt: Utilities.formatDate(new Date(entries[0].atMs), 'America/New_York', 'yyyy-MM-dd HH:mm z'),
