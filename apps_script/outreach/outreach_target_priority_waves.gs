/**
 * Replace the still-pending Figma intern-referral campaign with the already
 * approved C3.ai cold-email wave.  This is deliberately a single bounded
 * operation: it will do nothing if either campaign has started, changed size,
 * or no longer has only pending entries.  Figma's dedicated referral trigger
 * is removed because no Figma referral entry remains for it to deliver; C3.ai
 * continues on the shared recruiter trigger and Automatic modes are untouched.
 */
function replaceTargetReferralCampaign0916FigmaWithC3ai() {
  var figmaKey = 'TARGET_REFERRAL_CAMPAIGN_20260918_FIGMA';
  var c3Key = 'TARGET_RECRUITER_CAMPAIGN_20260919_C3AI';
  var figmaHandler = 'runTargetReferralCampaignTick0918Figma_';
  var startMs = new Date('2026-09-16T15:00:00-04:00').getTime();
  if (new Date().getTime() >= startMs) {
    throw new Error('The C3.ai replacement start time has passed.');
  }
  // Both campaigns are still future-only. Do not wait on the shared sender
  // lock: a stalled unrelated delivery tick cannot mutate either entry here.
  var props = PropertiesService.getScriptProperties();
  var figmaText = props.getProperty(figmaKey);
  var c3Text = props.getProperty(c3Key);
  if (!figmaText || !c3Text) {
    throw new Error('Both the pending Figma and C3.ai campaigns are required for replacement.');
  }
  var figma = JSON.parse(figmaText), c3 = JSON.parse(c3Text);
  var figmaEntries = figma.entries || [];
  var c3Entries = (c3.entries || []).slice().sort(function (left, right) {
    return Number(left.atMs) - Number(right.atMs);
  });
  if (figma.status !== 'scheduled' || figmaEntries.length !== 10 || figmaEntries.some(function (entry) {
    return entry.status !== 'pending' || entry.company !== 'Figma';
  })) {
    throw new Error('Figma must have exactly ten pending referral entries before replacement.');
  }
  if (c3.status !== 'scheduled' || c3Entries.length !== 7 || c3Entries.some(function (entry) {
    return entry.status !== 'pending' || entry.company !== 'C3.ai';
  })) {
    throw new Error('C3.ai must have exactly seven pending recruiter entries before replacement.');
  }
  var spacingMinutes = Number(c3.spacingMinutes || 6);
  c3Entries.forEach(function (entry, index) {
    entry.atMs = startMs + index * spacingMinutes * 60000;
  });
  c3.entries = c3Entries;
  c3.rescheduledAt = new Date().toISOString();
  c3.replacesCampaign = figmaKey;
  props.setProperty(c3Key, JSON.stringify(c3));
  props.deleteProperty(figmaKey);
  ScriptApp.getProjectTriggers().filter(function (trigger) {
    return trigger.getHandlerFunction() === figmaHandler;
  }).forEach(function (trigger) { ScriptApp.deleteTrigger(trigger); });
  refreshTargetQueueTabs_();
  return {
    cancelledFigmaReferrals: figmaEntries.length,
    movedC3aiRecruiterEmails: c3Entries.length,
    firstAt: Utilities.formatDate(new Date(c3Entries[0].atMs), 'America/New_York', 'yyyy-MM-dd HH:mm z'),
    lastAt: Utilities.formatDate(new Date(c3Entries[c3Entries.length - 1].atMs), 'America/New_York', 'yyyy-MM-dd HH:mm z'),
    removedTrigger: figmaHandler
  };
}

/**
 * Cancel all still-pending Wells Fargo outreach after the owner entered
 * process for both applied roles. This refuses any sent/drafted/otherwise
 * changed state, preserving mailbox history rather than rewriting it.
 */
function cancelAllTargetWellsFargoOutreach() {
  var referralKey = 'TARGET_REFERRAL_CAMPAIGN_20260917_WELLS_FARGO';
  var recruiterKey = 'TARGET_RECRUITER_CAMPAIGN_20260921_WELLS_FARGO';
  var referralHandler = 'runTargetReferralCampaignTick0917WellsFargo_';
  var props = PropertiesService.getScriptProperties();
  var referralText = props.getProperty(referralKey);
  var recruiterText = props.getProperty(recruiterKey);
  if (!referralText || !recruiterText) {
    throw new Error('Both Wells Fargo Target campaigns must exist before cancellation.');
  }
  var referral = JSON.parse(referralText), recruiter = JSON.parse(recruiterText);
  var referralEntries = referral.entries || [], recruiterEntries = recruiter.entries || [];
  var isPendingWellsFargo = function (entry) {
    return entry.status === 'pending' && entry.company === 'Wells Fargo';
  };
  if (referral.status !== 'scheduled' || referralEntries.length !== 5
      || !referralEntries.every(isPendingWellsFargo)) {
    throw new Error('Wells Fargo referral campaign must contain exactly five pending entries.');
  }
  if (recruiter.status !== 'scheduled' || recruiterEntries.length !== 5
      || !recruiterEntries.every(isPendingWellsFargo)) {
    throw new Error('Wells Fargo recruiter campaign must contain exactly five pending entries.');
  }
  var tracker = SpreadsheetApp.openById(outreachProperty_(PROP_TRACKER_ID, true));
  var queue = tracker.getSheetByName(TAB_QUEUE);
  if (!queue) throw new Error('Email queue is unavailable.');
  var normalRows = queue.getLastRow() < 2 ? []
    : queue.getRange(2, 1, queue.getLastRow() - 1, Q_WIDTH).getValues()
      .map(function (values, index) { return outreachParseQueue_(values, index); })
      .filter(function (row) {
        return outreachSameEmployer_(outreachCompanyTokens_('Wells Fargo'),
                                     outreachCompanyTokens_(row.company))
          && row.status !== STATUS_CANCELLED && row.status !== STATUS_SENT
          && row.status !== STATUS_REPLIED && row.status !== STATUS_BOUNCED
          && row.status !== STATUS_FAILED;
      });
  if (normalRows.length !== 1 || normalRows[0].status !== STATUS_QUEUED) {
    throw new Error('Expected exactly one queued normal Wells Fargo email before cancellation.');
  }
  var normal = normalRows[0];
  var updates = {};
  updates[Q_STATUS] = STATUS_CANCELLED;
  updates[Q_RESULT] = 'Cancelled by owner: applications are already in process.';
  outreachWriteRow_(queue, normal.rowNumber, updates);
  props.deleteProperty(referralKey);
  props.deleteProperty(recruiterKey);
  ScriptApp.getProjectTriggers().filter(function (trigger) {
    return trigger.getHandlerFunction() === referralHandler;
  }).forEach(function (trigger) { ScriptApp.deleteTrigger(trigger); });
  refreshTargetQueueTabs_();
  return {
    cancelledTargetReferrals: referralEntries.length,
    cancelledTargetRecruiters: recruiterEntries.length,
    cancelledNormalEmails: 1,
    removedTrigger: referralHandler
  };
}

/**
 * Repair the one normal-queue row offset caused by the first Wells Fargo
 * cancellation attempt, then cancel the actual Wells Fargo row. The recovery
 * is intentionally narrower than a generic requeue: both physical rows and
 * the exact owner-cancellation marker must match before anything is written.
 */
function repairWellsFargoNormalQueueCancellation() {
  var reason = 'Cancelled by owner: applications are already in process.';
  var tracker = SpreadsheetApp.openById(outreachProperty_(PROP_TRACKER_ID, true));
  var queue = tracker.getSheetByName(TAB_QUEUE);
  if (!queue || queue.getLastRow() < 2) throw new Error('Email queue is unavailable.');
  var rows = queue.getRange(2, 1, queue.getLastRow() - 1, Q_WIDTH).getValues()
    .map(function (values, index) {
      var row = outreachParseQueue_(values, index);
      row.result = outreachCell_(values, Q_RESULT);
      return row;
    });
  var wells = rows.filter(function (row) {
    return outreachSameEmployer_(outreachCompanyTokens_('Wells Fargo'),
                                 outreachCompanyTokens_(row.company))
      && row.status === STATUS_QUEUED;
  });
  if (wells.length !== 1) {
    throw new Error('Expected exactly one queued Wells Fargo normal email for repair.');
  }
  var correct = wells[0];
  var accidental = rows.filter(function (row) {
    return row.rowNumber === correct.rowNumber + 2
      && !outreachSameEmployer_(outreachCompanyTokens_('Wells Fargo'),
                                outreachCompanyTokens_(row.company))
      && row.status === STATUS_CANCELLED && row.result === reason && !row.draftId;
  });
  if (accidental.length !== 1) {
    throw new Error('The exact accidental normal-queue cancellation marker was not found.');
  }
  var restored = accidental[0];
  var restore = {};
  restore[Q_STATUS] = STATUS_QUEUED;
  restore[Q_RESULT] = 'Explicit off-Target weekend timing; restored after unrelated cancellation-row indexing error.';
  outreachWriteRow_(queue, restored.rowNumber, restore);
  var cancel = {};
  cancel[Q_STATUS] = STATUS_CANCELLED;
  cancel[Q_RESULT] = reason;
  outreachWriteRow_(queue, correct.rowNumber, cancel);
  return {restoredCompany: restored.company, restoredRow: restored.rowNumber,
    cancelledCompany: correct.company, cancelledRow: correct.rowNumber};
}

