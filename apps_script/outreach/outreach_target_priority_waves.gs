/**
 * Point the booked Robinhood wave at the Web application, pending entries only.
 *
 * Recipients, times, spacing and template numbers are all left exactly as they
 * are: this changes what the message is *about*, not who gets it or when, so
 * re-running the scheduler would be the wrong tool — it would re-pick contacts
 * and re-stamp hours that the owner has already approved.
 *
 * It refuses outright the moment any entry has left `pending`. A sent message
 * cited the Backend requisition and that is what the recipient read; rewriting
 * the row afterwards would make the history describe an email nobody was sent.
 */
function retargetTargetRecruiterCampaign0924RobinhoodToWeb() {
  var key = 'TARGET_RECRUITER_CAMPAIGN_20260924_ROBINHOOD';
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('Another outreach run holds the lock.');
  try {
    var props = PropertiesService.getScriptProperties();
    var text = props.getProperty(key);
    if (!text) throw new Error('Robinhood campaign does not exist: ' + key);
    var state = JSON.parse(text);
    var entries = state.entries || [];
    var settled = entries.filter(function (entry) { return entry.status !== 'pending'; });
    if (settled.length) {
      throw new Error('Refusing to retarget: ' + settled.length + ' entr'
        + (settled.length === 1 ? 'y has' : 'ies have') + ' already left pending.');
    }
    if (!entries.length) throw new Error('The Robinhood campaign holds no entries.');
    var changed = 0;
    entries.forEach(function (entry) {
      if (entry.company !== 'Robinhood') return;
      entry.role = ROBINHOOD_WEB_APPLICATION_.role;
      entry.jobLink = ROBINHOOD_WEB_APPLICATION_.jobLink;
      changed++;
    });
    props.setProperty(key, JSON.stringify(state));
    try { refreshTargetQueueTabs_(); }
    catch (mirrorError) { Logger.log('Target mirror refresh failed: ' + mirrorError); }
    return {retargeted: changed, role: ROBINHOOD_WEB_APPLICATION_.role,
            firstAt: entries[0].scheduledAt || '', key: key};
  } finally {
    lock.releaseLock();
  }
}
