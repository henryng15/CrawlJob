      title: person.title, seniority: person.seniority || '', angle: person.angle || '', bucket: person.bucket || '',
      template: index + 1, atMs: startMs + index * 9 * 60000, status: 'pending'};
  });
  ScriptApp.getProjectTriggers().forEach(function (trigger) {
    if (trigger.getHandlerFunction() === handler) ScriptApp.deleteTrigger(trigger);
  });
  var state = {status: 'scheduled', timezone: 'America/New_York', createdAt: new Date().toISOString(),
    lastSentAtMs: 0, spacingMinutes: 9, minGapMinutes: 8, entries: entries};
  props.setProperty(key, JSON.stringify(state));
  try { ScriptApp.newTrigger(handler).timeBased().everyMinutes(1).create(); }
  catch (error) { props.deleteProperty(key); throw error; }
  refreshTargetQueueTabs_();
  return {scheduled: entries.length, byCompany: summarizeTargetCampaignState_(state, 'Wells Fargo').byCompany,
    firstAt: Utilities.formatDate(new Date(entries[0].atMs), 'America/New_York', 'yyyy-MM-dd HH:mm z'),
    lastAt: Utilities.formatDate(new Date(entries[entries.length - 1].atMs), 'America/New_York', 'yyyy-MM-dd HH:mm z'), trigger: handler};
}

