    if ((state.entries || []).some(function (entry) { return entry.status !== 'pending'; })) {
      throw new Error('Figma referral campaign has a non-pending entry and cannot be moved.');
    }
    var spacing = Number(state.spacingMinutes || 9);
    state.entries.sort(function (left, right) { return Number(left.atMs) - Number(right.atMs); })
      .forEach(function (entry, index) { entry.atMs = startMs + index * spacing * 60000; });
    props.setProperty(key, JSON.stringify(state));
    try { refreshTargetQueueTabs_(); }
    catch (mirrorError) { Logger.log('Target mirror refresh failed: ' + mirrorError); }
    return summarizeTargetCampaignState_(state, 'Figma');
  } finally {
    lock.releaseLock();
