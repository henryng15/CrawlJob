/** Cancel only the still-pending Intel entry in the shared 09/16 Intel/Atlassian campaign. */
function cancelPendingIntelRecruiterEntry0916_() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('Another outreach run holds the lock.');
  try {
    var key = 'TARGET_RECRUITER_CAMPAIGN_20260916_INTEL_ATLASSIAN';
    var props = PropertiesService.getScriptProperties(), text = props.getProperty(key);
    if (!text) throw new Error('Intel/Atlassian campaign is missing.');
    var state = JSON.parse(text), cancelled = 0, alreadyCancelled = 0;
    (state.entries || []).forEach(function (entry) {
      if (entry.company !== 'Intel') return;
      if (entry.status === 'cancelled'
          && String(entry.error || '').indexOf('10-contact Intel recruiter wave') !== -1) {
        alreadyCancelled++;
        return;
      }
      if (entry.status !== 'pending') throw new Error('Intel entry is no longer pending and cannot be rescheduled.');
      entry.status = 'cancelled'; entry.cancelledAt = new Date().toISOString();
      entry.error = 'Rescheduled into the owner-requested 10-contact Intel recruiter wave on 2026-09-22.'; cancelled++;
    });
    if (cancelled + alreadyCancelled !== 1) {
      throw new Error('Expected one Intel entry; found ' + (cancelled + alreadyCancelled) + '.');
    }
    if (cancelled) { props.setProperty(key, JSON.stringify(state)); refreshTargetQueueTabs_(); }
    return {cancelled: cancelled, alreadyCancelled: alreadyCancelled};
  } finally { lock.releaseLock(); }
}

