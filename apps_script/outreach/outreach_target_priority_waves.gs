/**
 * Rebalance the owner-selected 15 pending recruiter sends from Tuesday into
 * Monday, preserving every recipient, template and campaign identity.
 */
function rescheduleTargetRecruiterCampaigns0921CoinbaseLockheedMartin() {
  var plans = [
    {propertyKey: 'TARGET_RECRUITER_CAMPAIGN_20260922_LOCKHEED_MARTIN',
     company: 'Lockheed Martin', startIso: '2026-09-21T09:00:00-04:00', expected: 5},
    {propertyKey: 'TARGET_RECRUITER_CAMPAIGN_20260922_COINBASE',
     company: 'Coinbase', startIso: '2026-09-21T10:00:00-04:00', expected: 10}
  ];
  if (plans.some(function (plan) { return new Date().getTime() >= new Date(plan.startIso).getTime(); })) {
    throw new Error('The new Monday recruiter times must remain in the future.');
  }
  // Both campaign dates are future-only, so the delivery ticks cannot mutate
  // these entries while the retime runs. Avoid the global sender lock here:
  // the several per-minute delivery triggers can otherwise starve a pure
  // schedule edit even though neither campaign is due.
  var props = PropertiesService.getScriptProperties(), changed = [];
  var prepared = plans.map(function (plan) {
      var text = props.getProperty(plan.propertyKey);
      if (!text) throw new Error('Recruiter campaign does not exist: ' + plan.propertyKey);
      var state = JSON.parse(text), entries = (state.entries || []).slice().sort(function (left, right) {
        return Number(left.atMs) - Number(right.atMs);
      });
      if (state.status !== 'scheduled' || entries.length !== plan.expected || entries.some(function (entry) {
        return entry.status !== 'pending' || entry.company !== plan.company;
      })) {
        throw new Error(plan.company + ' must contain exactly ' + plan.expected + ' pending entries before rebalancing.');
      }
      var startMs = new Date(plan.startIso).getTime(), spacingMinutes = Number(state.spacingMinutes || 6);
      entries.forEach(function (entry, index) { entry.atMs = startMs + index * spacingMinutes * 60000; });
      state.entries = entries;
      state.rescheduledAt = new Date().toISOString();
      return {plan: plan, state: state, entries: entries};
  });
  prepared.forEach(function (item) {
    props.setProperty(item.plan.propertyKey, JSON.stringify(item.state));
    changed.push({company: item.plan.company, moved: item.entries.length,
      firstAt: Utilities.formatDate(new Date(item.entries[0].atMs), 'America/New_York', 'yyyy-MM-dd HH:mm z'),
      lastAt: Utilities.formatDate(new Date(item.entries[item.entries.length - 1].atMs), 'America/New_York', 'yyyy-MM-dd HH:mm z')});
  });
  refreshTargetQueueTabs_();
  return {moved: changed.reduce(function (sum, item) { return sum + item.moved; }, 0), campaigns: changed};
}

