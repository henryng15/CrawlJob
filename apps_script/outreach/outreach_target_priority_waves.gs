  if (people.length !== 5) throw new Error('Expected five unspent Wells Fargo recruiters; found ' + people.length + '.');
  var role = '2027 Technology Summer Internship – Early Careers (Software Engineering)';
  var jobLink = 'https://wd1.myworkdaysite.com/en-US/recruiting/wf/WellsFargoJobs/job/XMLNAME-2027-Technology-Summer-Internship---Early-Careers--Software-Engineering-_R-574285';
