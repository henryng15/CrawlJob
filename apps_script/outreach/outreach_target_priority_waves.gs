/**
 * Apply the owner's explicit "anh Hoang" decision without retiming or expanding
 * the already-pending seven-person Intel referral wave. Piotr is the only
 * supplemental recipient replaced; the source contact row remains untouched.
 */
function replaceIntelReferralCampaign0916WithApprovedHoang() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('Another outreach run holds the lock.');
  try {
    var key = 'TARGET_REFERRAL_CAMPAIGN_20260916_INTEL';
    var props = PropertiesService.getScriptProperties(), text = props.getProperty(key);
    if (!text) throw new Error('Intel referral campaign is missing.');
    var state = JSON.parse(text), entries = state.entries || [];
    var already = entries.filter(function (entry) {
      return entry.company === 'Intel' && entry.email === 'hoang.nguyen@intel.com'
        && entry.copy === 'henry_vietnamese' && entry.vietnameseName === 'Hoang'
        && entry.vietnameseTitle === 'anh';
    });
    if (already.length === 1) return {alreadyApplied: true, entry: already[0]};
    if (already.length) throw new Error('Intel campaign contains an inconsistent Hoang Nguyen entry.');
    if (entries.length !== 7 || entries.some(function (entry) { return entry.status !== 'pending'; })) {
      throw new Error('Intel referral campaign must contain exactly seven pending entries before this replacement.');
    }

    var contactsBook = SpreadsheetApp.openById(outreachProperty_(PROP_CONTACTS_ID, true));
    var hoang = outreachEmployeesFor_(outreachReadEmployees_(contactsBook), 'Intel').filter(function (person) {
      return person.email === 'hoang.nguyen@intel.com' && person.name === 'Hoang Nguyen';
    })[0];
    if (!hoang) throw new Error('Approved Intel employee Hoang Nguyen is no longer eligible in Employees (seed).');
    if (GmailApp.search('from:me to:' + hoang.email, 0, 1).length) {
      throw new Error('Hoang Nguyen already has outbound Gmail history; refusing a duplicate referral request.');
    }
    var replacementIndex = entries.map(function (entry, index) {
      return entry.company === 'Intel' && entry.name === 'Piotr Bocian' ? index : -1;
    }).filter(function (index) { return index >= 0; });
    if (replacementIndex.length !== 1) throw new Error('Expected exactly one pending Piotr Bocian supplemental entry.');

    var prior = entries[replacementIndex[0]];
    entries[replacementIndex[0]] = {
      company: prior.company, role: prior.role, jobLink: prior.jobLink,
      name: hoang.name, email: hoang.email, title: hoang.title,
      seniority: hoang.seniority || '', angle: hoang.angle || '', bucket: hoang.bucket || '',
      template: prior.template, atMs: prior.atMs, status: 'pending',
      copy: 'henry_vietnamese', vietnameseName: 'Hoang', vietnameseTitle: 'anh', vietnameseVariant: 1
    };
    props.setProperty(key, JSON.stringify(state));
    refreshTargetQueueTabs_();
    return {replaced: 'Piotr Bocian', approvedRecipient: 'Hoang Nguyen', greeting: 'anh Hoang',
            at: Utilities.formatDate(new Date(prior.atMs), 'America/New_York', 'yyyy-MM-dd HH:mm'), total: entries.length};
  } finally { lock.releaseLock(); }
}

