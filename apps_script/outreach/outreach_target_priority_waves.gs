 * different thing from `valid` and is recorded as `accept_all` in the Verify
 * column, never rounded up. This roster has its own wrapper so it can only enter
 * a campaign on an explicit decision to accept that risk.
 */
var TARGET_SWELIKE_RECRUITERS_ACCEPT_ALL_20260917_ = [
  {company: 'Klaviyo', name: 'Kara Hebb', email: 'kara.hebb@klaviyo.com',
   role: 'Senior Campus Recruiter', focus: 'university', verify: 'trykitt:accept_all'},
