/** Turn one approved roster into the scheduler's per-company specs. */
function targetSweLikeCompanySpecs_(roster) {
  var counts = {}, order = [];
  roster.forEach(function (person) {
    if (counts[person.company] === undefined) { counts[person.company] = 0; order.push(person.company); }
    counts[person.company]++;
  });
  return order.map(function (company) {
    var application = TARGET_SWELIKE_APPLICATIONS_20260917_[company];
    if (!application) throw new Error('No checked application for ' + company);
    return {company: company, maxContacts: counts[company],
            role: application.role, jobLink: application.jobLink};
  });
}

