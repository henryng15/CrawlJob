# Copy to .env and fill in. Never commit .env (see .gitignore).
#   cp .env.example .env && chmod 600 .env

# ---- application ----------------------------------------------------------
APP_ENV=development
APP_TIMEZONE=America/New_York
APP_BASE_URL=http://localhost:8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=

# ---- web sign-in ----------------------------------------------------------
# Required in production; without it nobody can sign in, including you.
# Generate with: uv run internship-ops hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Idle timeout: the cookie is re-signed on every request, so working keeps you
# signed in and walking away does not.
SESSION_IDLE_TIMEOUT_MINUTES=60
# Must be true in production, where everything is HTTPS via Tailscale Serve.
SESSION_COOKIE_SECURE=false

# ---- storage --------------------------------------------------------------
# Port 5442, not 5432: docker-compose.yml moves the development database off the
# default so it cannot collide with another project's Postgres.
DATABASE_URL=postgresql+psycopg://internship_ops:internship_ops_dev@localhost:5442/internship_ops
DATA_DIR=/data/internship-ops

# ---- llm ------------------------------------------------------------------
# "null" uses a stub provider that makes no API calls — the default for development.
LLM_PROVIDER=null
ANTHROPIC_API_KEY=
LLM_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
LLM_WRITING_MODEL=claude-sonnet-5
LLM_MONTHLY_BUDGET_USD=15

# ---- gmail ----------------------------------------------------------------
# Publish the OAuth app to "In production" in Google Cloud Console. A project left
# in "Testing" expires refresh tokens after 7 days and outreach will break weekly.
GMAIL_CREDENTIALS_PATH=/data/internship-ops/secrets/gmail_client.json
GMAIL_TOKEN_PATH=/data/internship-ops/secrets/gmail_token.enc

# ---- pipeline gates -------------------------------------------------------
# The master switch, off by default. Discovery, tailoring, browser preparation
# and outreach all refuse to run while this is false. Backups, cleanup and
# reconciliation keep running regardless — pausing must not stop the jobs that
# protect data that already exists.
PIPELINE_ENABLED=false
# A declaration that a base resume exists to tailor from. It is checked against
# the database as well, so setting it without importing a resume changes nothing.
BASE_RESUME_STATUS=MISSING

# ---- orchestration --------------------------------------------------------
# Local wall-clock times, comma-separated. Each is a separate run with its own
# idempotency key; the daily quota below is shared across all of them.
ORCHESTRATION_TIMES=08:00,14:00

# ---- capacity -------------------------------------------------------------
# Per calendar day across every run, not per run.
MAX_PREPARED_APPLICATIONS_PER_DAY=30
MAX_BROWSER_WORKERS=2
MAX_LIVE_SESSIONS=2
LIVE_SESSION_TTL_HOURS=8
# How long a prepared application waits for you before it expires. Expiry is a
# state change, never a delete: resume, answers, screenshots and audit trail all
# survive so it can be restored.
PREPARED_APPLICATION_TTL_HOURS=24

# ---- outreach -------------------------------------------------------------
OUTREACH_INITIAL_DAILY_LIMIT=3
OUTREACH_MAX_DAILY_LIMIT=5
OUTREACH_DELAY_BUSINESS_DAYS=2
OUTREACH_MAX_PER_COMPANY_30D=2
OUTREACH_MAX_FOLLOWUPS=1

# ---- selection ------------------------------------------------------------
MINIMUM_FIT_SCORE=72
MAX_ROLE_AGE_DAYS=21
# Freshness window, measured against posted_at when the board gives one and
# against first_seen_at only when it does not.
MAX_ROLE_AGE_HOURS=24
MAX_ACTIVE_APPLICATIONS_PER_COMPANY=2
# The role variants to apply for, comma-separated. Leave empty to use the
# shipped list (app/services/filters.py). Write them normalized: lowercase, no
# season or year, "backend" as "back end", "devops" as "dev ops" — that is the
# form titles are folded into before they are compared.
ROLE_TITLE_VARIANTS=
# Terms that disqualify a title even when it matched a variant above, so
# "Senior Software Engineer Intern" is turned away. Empty uses the shipped list.
ROLE_REJECT_TERMS=

# ---- opt-in ---------------------------------------------------------------
PUBLIC_JOB_SCRAPING_ENABLED=false

# ---- permanently disabled -------------------------------------------------
# These exist only so an operator can see they are off. Setting any of them to a
# truthy value makes the application refuse to start (app/safety.py).
AUTO_SUBMIT_ENABLED=false
AUTO_SEND_EMAIL_ENABLED=false
CAPTCHA_BYPASS_ENABLED=false
LINKEDIN_AUTOMATION_ENABLED=false
