# Share the spreadsheet with the service-account client_email in this JSON.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Jobs
# The application tracker, read to tick Applied on jobs already sent.
GOOGLE_SHEET_APP_TAB=App
# Danh bạ alumni, dùng để tô vàng người làm ở công ty đã nộp. Bỏ qua nếu chưa có tab.
GOOGLE_SHEET_ALUMNI_TAB=Alumni
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional additional feeds. Leave blank to skip them without failing a sync.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
