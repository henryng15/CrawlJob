# Keep the build context small and, more importantly, keep secrets out of it.
# Anything copied into a layer is recoverable from the image even if a later
# layer deletes it.

.env
.env.*
!.env.example
secrets/
*.pem
*.key
**/gmail_token*
**/oci_api_key*

.git
.github
.venv
.ruff_cache
.mypy_cache
.pytest_cache
**/__pycache__
*.pyc

# Not needed at runtime, and the spec alone is 4,000 lines.
docs/
tests/
browser/fake_ats/
htmlcov/
.coverage
data/
logs/
*.md
!README.md
