# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (§17.4).
#
# Everything here comes from the OCI console. The walkthrough is in README.md
# next to this file.

tenancy_ocid        = "ocid1.tenancy.oc1..aaaa..."
user_ocid           = "ocid1.user.oc1..aaaa..."
compartment_ocid    = "ocid1.tenancy.oc1..aaaa..."  # the tenancy root is fine
api_key_fingerprint = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
region              = "us-ashburn-1"                # must be your HOME region

# Your own address, with /32. Never 0.0.0.0/0 — Terraform refuses that.
#   curl -s https://api.ipify.org
admin_cidr = "203.0.113.42/32"

ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
api_private_key_path = "~/.oci/oci_api_key.pem"

# Optional. An ephemeral, pre-authorised key from
# https://login.tailscale.com/admin/settings/keys makes the instance join the
# tailnet on first boot, so the public SSH path is never needed.
# tailscale_auth_key = "tskey-auth-..."

# A1 capacity is scarce. If apply fails with "Out of host capacity", try 1 then 2
# before anything else — it is the single most effective retry.
# availability_domain_index = 1
