#cloud-config
# First boot (spec §17.8, §18).
#
# The one dangerous thing here is formatting the data volume. §17.8 is emphatic:
# never identify a disk by a guessed device name, and never format one that
# already has a filesystem. The script below does both checks and exits rather
# than proceeding when either is unclear — a wrong guess destroys every
# application the user has ever prepared.

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - git
  - jq
  - unattended-upgrades
  - fail2ban
  - postgresql-client

# No extra user. The image ships `ubuntu` with the operator's SSH key already
# authorised, and a second account would only mean deploy.sh writing as one user
# into directories owned by another.

write_files:
  - path: /usr/local/sbin/mount-data-volume.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      # Find, format-if-empty, and mount the attached data volume at /data.
      set -euo pipefail

      log() { printf '[data-volume] %s\n' "$*"; }

      # The boot disk is whichever device holds the mounted root. Everything else
      # attached and unmounted is a candidate. Naming /dev/sdb directly is what
      # §17.8 forbids: attachment order is not guaranteed.
      root_disk="$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null || true)"
      candidates=()
      while read -r name type mountpoint; do
        [[ "$type" == "disk" ]] || continue
        [[ "$name" != "$root_disk" ]] || continue
        [[ -z "$mountpoint" ]] || continue
        # Skip anything with mounted partitions: it is in use even if the disk
        # itself is not.
        if lsblk -no MOUNTPOINT "/dev/$name" | grep -q '[^[:space:]]'; then continue; fi
        candidates+=("$name")
      done < <(lsblk -no NAME,TYPE,MOUNTPOINT)

      if [[ "$${#candidates[@]}" -eq 0 ]]; then
        log "no unmounted data disk found; nothing to do"
        exit 0
      fi
      if [[ "$${#candidates[@]}" -gt 1 ]]; then
        # Ambiguity here means picking wrong is possible, and picking wrong means
        # formatting the wrong disk. Stop and let a human look.
        log "ERROR: several candidate disks ($${candidates[*]}); refusing to guess"
        exit 1
      fi

      device="/dev/$${candidates[0]}"
      log "candidate: $device"

      existing="$(blkid -o value -s TYPE "$device" 2>/dev/null || true)"
      if [[ -n "$existing" ]]; then
        log "$device already holds a $existing filesystem; not formatting"
      else
        log "formatting $device as ext4 (first boot)"
        mkfs.ext4 -L internship-data "$device"
      fi

      uuid="$(blkid -o value -s UUID "$device")"
      [[ -n "$uuid" ]] || { log "ERROR: no UUID after format"; exit 1; }

      mkdir -p /data
      # By UUID, not by device name: the name can change across a reattach, and
      # an fstab entry that points at the wrong disk fails the boot.
      if ! grep -q "$uuid" /etc/fstab; then
        printf 'UUID=%s /data ext4 defaults,noatime,nofail 0 2\n' "$uuid" >> /etc/fstab
        log "added /etc/fstab entry for $uuid"
      fi
      mountpoint -q /data || mount /data

      install -d -o ${app_user} -g ${app_user} -m 0755 /data/internship-ops
      for dir in artifacts backups browser-profiles browser-sessions postgres; do
        install -d -o ${app_user} -g ${app_user} -m 0755 "/data/internship-ops/$dir"
      done
      # 0700: secrets, and the backups that contain everything the secrets protect.
      install -d -o ${app_user} -g ${app_user} -m 0700 /data/internship-ops/secrets
      chmod 0700 /data/internship-ops/backups
      log "ready"

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    permissions: "0644"
    content: |
      # Keys only. A password-authenticated SSH port reachable from anywhere is
      # the way this instance gets taken, and it holds every locked fact.
      PasswordAuthentication no
      PermitRootLogin no
      KbdInteractiveAuthentication no

runcmd:
  # Docker from the official repository. Ubuntu's docker.io package lags far
  # enough behind that compose file features fail in confusing ways.
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - >
    echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.asc]
    https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable"
    > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - >
    apt-get install -y docker-ce docker-ce-cli containerd.io
    docker-buildx-plugin docker-compose-plugin
  - usermod -aG docker ${app_user}
  - systemctl enable --now docker

  - curl -fsSL https://tailscale.com/install.sh | sh
  - |
    if [ -n "${tailscale_auth_key}" ]; then
      # --hostname explicitly: deploy.sh addresses the box by MagicDNS name, and
      # letting it default to whatever the OS decided is a way to be unreachable.
      tailscale up --ssh --accept-dns=false --hostname=internshipops \
        --authkey='${tailscale_auth_key}'
    fi

  - /usr/local/sbin/mount-data-volume.sh
  - systemctl restart ssh

  # Chromium in the browser slots needs more than the default. Without this the
  # slots die under memory pressure rather than queueing, which looks like a bug
  # in the worker.
  - sysctl -w vm.max_map_count=262144
  - echo "vm.max_map_count=262144" > /etc/sysctl.d/99-internship-ops.conf

final_message: |
  Bootstrap finished in $UPTIME seconds.
  Check: df -h /data && docker --version && tailscale status
