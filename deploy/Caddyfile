# Reverse proxy for the whole stack.
#
# Binds inside the container only; compose publishes it on host loopback and
# Tailscale Serve puts private HTTPS in front. Never Tailscale Funnel.
#
# It fronts the web app and nothing else now. The browser workers used to serve
# a noVNC session here so the user could finish a form inside our browser; they
# are headless and unreachable, and forms that need a person are finished in the
# user's own browser instead.

:8080 {
	encode zstd gzip

	log {
		output stdout
		format console
		# The URL of a job application carries the employer and often the
		# requisition; §23.5 keeps that out of routine logs.
		level WARN
	}

	header {
		-Server
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}
	# forward_auth is the only caller. Reaching it from outside would prove
	# nothing — it validates a cookie the client already holds — but there is no
	# reason to publish it.
	handle /internal/* {
		respond 404
	}

	# Health endpoints are unauthenticated by design and carry no job, company or
	# person (§25.1).
	handle /health/* {
		reverse_proxy web:8000
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
