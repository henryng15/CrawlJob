{
  "manifest_version": 3,
  "name": "Quick Add Application",
  "version": "1.0.0",
  "description": "Add an external job application to the App tab.",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_title": "Add application"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
